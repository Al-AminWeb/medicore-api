<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MediCore - Verification Code</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .email-container {
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            max-width: 480px;
            width: 100%;
            overflow: hidden;
            animation: slideUp 0.6s ease;
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 40px 30px;
            text-align: center;
            position: relative;
        }

        .header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.08'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
            opacity: 0.5;
        }

        .logo {
            width: 70px;
            height: 70px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            backdrop-filter: blur(10px);
            border: 2px solid rgba(255, 255, 255, 0.3);
            position: relative;
            z-index: 1;
        }

        .logo svg {
            width: 35px;
            height: 35px;
            fill: white;
        }

        .brand-name {
            color: #ffffff;
            font-size: 28px;
            font-weight: 700;
            letter-spacing: 1px;
            position: relative;
            z-index: 1;
        }

        .brand-tagline {
            color: rgba(255, 255, 255, 0.8);
            font-size: 13px;
            margin-top: 8px;
            letter-spacing: 0.5px;
            position: relative;
            z-index: 1;
        }

        .content {
            padding: 40px 35px;
            text-align: center;
        }

        .greeting {
            color: #2d3748;
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 15px;
        }

        .greeting span {
            color: #667eea;
            font-weight: 700;
        }

        .message {
            color: #718096;
            font-size: 16px;
            line-height: 1.7;
            margin-bottom: 30px;
        }

        .otp-container {
            background: linear-gradient(135deg, #f7fafc 0%, #edf2f7 100%);
            border-radius: 16px;
            padding: 30px;
            margin-bottom: 25px;
            border: 2px dashed #cbd5e0;
            position: relative;
        }

        .otp-label {
            color: #a0aec0;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 600;
            margin-bottom: 15px;
            display: block;
        }

        .otp-code {
            font-size: 42px;
            font-weight: 800;
            color: #667eea;
            letter-spacing: 8px;
            text-shadow: 2px 2px 4px rgba(102, 126, 234, 0.2);
            font-family: 'Courier New', monospace;
        }

        .timer {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 20px;
            color: #e53e3e;
            font-size: 14px;
            font-weight: 500;
        }

        .timer svg {
            width: 18px;
            height: 18px;
            animation: pulse 1.5s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        .security-note {
            background: #c6f6d5;
            border-left: 4px solid #48bb78;
            padding: 15px 20px;
            border-radius: 8px;
            text-align: left;
            margin-top: 25px;
        }

        .security-note p {
            color: #22543d;
            font-size: 13px;
            line-height: 1.6;
            margin: 0;
        }

        .security-note strong {
            display: block;
            margin-bottom: 5px;
            font-size: 14px;
        }

        .footer {
            background: #f7fafc;
            padding: 25px 35px;
            text-align: center;
            border-top: 1px solid #e2e8f0;
        }

        .footer-text {
            color: #a0aec0;
            font-size: 13px;
            margin-bottom: 10px;
        }

        .social-links {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 15px;
        }

        .social-links a {
            width: 35px;
            height: 35px;
            background: #e2e8f0;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .social-links a:hover {
            background: #667eea;
            transform: translateY(-3px);
        }

        .divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, #cbd5e0, transparent);
            margin: 20px 0;
        }

        @media (max-width: 480px) {
            .email-container {
                border-radius: 0;
            }

            .content {
                padding: 30px 25px;
            }

            .otp-code {
                font-size: 32px;
                letter-spacing: 6px;
            }
        }
    </style>
</head>
<body>
<div class="email-container">
    <!-- Header -->
    <div class="header">
        <div class="logo">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
            </svg>
        </div>
        <h1 class="brand-name">MediCore</h1>
        <p class="brand-tagline">Secure Healthcare Management</p>
    </div>

    <!-- Content -->
    <div class="content">
        <h2 class="greeting">Hello <span><%= name %></span></h2>

        <p class="message">
            Thank you for choosing MediCore for your healthcare needs.
            To ensure the security of your account, please use the verification code below.
        </p>

        <div class="otp-container">
            <span class="otp-label">Verification Code</span>
            <div class="otp-code"><%= otp %></div>

            <div class="timer">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 6v6l4 2"/>
                </svg>
                <span>Expires in 2 minutes</span>
            </div>
        </div>

        <div class="security-note">
            <p>
                <strong>🔒 Security Notice</strong>
                Never share this code with anyone. Our team will never ask for your OTP.
                If you didn't request this code, please ignore this email.
            </p>
        </div>
    </div>

    <!-- Footer -->
    <div class="footer">
        <p class="footer-text">
            Need help? Contact us at <a href="mailto:support@medicore.com" style="color: #667eea; text-decoration: none;">support@medicore.com</a>
        </p>
        <div class="divider"></div>
        <p class="footer-text">
            © 2026 MediCore Health Systems. All rights reserved.
        </p>
    </div>
</div>
</body>
</html>